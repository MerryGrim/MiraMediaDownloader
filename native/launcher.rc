#include <windows.h>
#include "launcher_version.h"

101 ICON "../assets/mira.ico"
201 RCDATA "../assets/installer-welcome-cloud-v1.png"
1 RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MIRA_VERSION_NUM
 PRODUCTVERSION MIRA_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Mira\0"
      VALUE "FileDescription", "Mira Media Downloader native startup\0"
      VALUE "FileVersion", MIRA_VERSION_STR
      VALUE "InternalName", "MiraMediaDownloader\0"
      VALUE "LegalCopyright", "GPL-2.0-or-later\0"
      VALUE "OriginalFilename", "MiraMediaDownloader.exe\0"
      VALUE "ProductName", "Mira Media Downloader\0"
      VALUE "ProductVersion", MIRA_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

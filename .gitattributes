* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.cpp text eol=lf
*.rc text eol=crlf
*.png binary
*.ico binary
*.gz binary
*.zip binary

# Upstream notices and Qt snapshot manifests use byte-exact SHA-256 values.
licenses/** -text
*.sha256 text eol=lf
